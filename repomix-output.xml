        @Nullable SignedAlbumContent content = stack.get(Exposure.DataComponents.SIGNED_ALBUM_CONTENT);
        if (content != null) {
            String title = content.title();
            if (!StringUtil.isBlank(title)) {
                return Component.literal(title);
