        Image.validate(width, height, pixels.length);
    }

    public PalettedImage(int width, int height, byte[] pixels, Identifier paletteId) {
        this(width, height, pixels, ColorPalettes.get(Minecrft.registryAccess(), paletteId).value());
    }

